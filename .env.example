# ===== 运行环境 =====
# local / dev / prod：仅影响健康检查等环境标识与默认播种行为
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000
# 允许跨域来源，逗号分隔
APP_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ===== 数据与口径 =====
# SQLite 文件路径；留空默认 backend/data/app.db。生产挂载持久卷或改绝对路径。
DATABASE_URL=
# 启动时是否执行迁移（幂等）
MIGRATE_ON_START=1
# 启动时是否补写样例数据：本地=1；生产必须=0，样例只补缺失、永不覆盖运行数据
SEED_ON_START=1

# ===== 前端（frontend/.env.development 也有一份） =====
VITE_API_BASE=
VITE_PROXY_TARGET=http://127.0.0.1:8000
