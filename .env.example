# 根目录示例环境变量（docker compose 会读取）。
# 后端完整配置见 backend/.env.example，前端见 frontend/.env.development / .env.production
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
# SQLite 文件落在容器卷里，重启不丢；样例只在 local 幂等补齐，不覆盖运行数据
APP_DATABASE_URL=sqlite:///data/app.db
APP_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# 概览“当日新增”参考日；留空取当天
APP_OVERVIEW_TODAY=

# 前端（Vite，构建期注入）
VITE_PROXY_TARGET=http://backend:8000
