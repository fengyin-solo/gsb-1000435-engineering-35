# ===== 运行环境 =====
# local：本地开发，启动时自动幂等写入样例；prod：只建表，不碰样例
APP_ENV=local
APP_NAME=冷链物流温控管理平台
APP_HOST=127.0.0.1
APP_PORT=8000

# 允许访问后端的前端来源，逗号分隔
APP_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ===== 数据口径 =====
# SQLite 落库文件；:memory: 表示进程内内存库（仅测试用）
APP_DATABASE_URL=sqlite:///data/app.db
# 启动时是否幂等写入样例数据；不填时 local=true、prod=false
# 口径优先级：运行数据（API 写入/动作流转）> 样例数据，样例永远不覆盖同 id 运行记录
APP_SEED_ON_STARTUP=
# 概览“当日新增”的参考自然日，留空取服务器当天；演示/验收可固定为 2026-09-02
APP_OVERVIEW_TODAY=
